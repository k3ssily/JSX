function App() {
  let hora = Number(prompt("Digite a hora:"));
  let mensagem = "";

  if (hora >= 5 && hora <= 11) {
    mensagem = "Bom dia";
  } else if (hora >= 12 && hora <= 17) {
    mensagem = "Boa tarde";
  } else {
    mensagem = "Boa noite";
  }

  return (
    <div>
      <h1>{mensagem} {hora}</h1>
    </div>
  );
}

export default App;
